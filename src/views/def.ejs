 <!-- Contenu principal centré -->
 <div id="app" class="d-flex justify-content-center min-vh-100">
  <div class="container-fluid px-4">
    <h1>Définir le mot : <%= word %></h1>

    <!-- Timer s'affichera ici -->
    <div id="timer-container"></div>

    <% if (isConnected) { %>
      <p>Connecté en tant que : <strong><%= pseudo %></strong> | Score actuel : <strong><%= globalScore %></strong></p>
    <% } else { %>
      <p><em>Non connecté - les points ne seront pas enregistrés.</em></p>
    <% } %>

    <p>Vous avez <strong><%= time %></strong> secondes pour entrer autant de définitions que possible.</p>

    <form method="POST" action="/jeu/def/<%= wordId %>">
      <input type="hidden" name="wordId" value="<%= wordId %>" />
      <div id="definition-list">
        <input type="text" name="definition" placeholder="Définition 1" required /><br />
      </div>

      <button type="button" onclick="ajouterChamp()">+ Ajouter une autre définition</button><br><br>
      <button type="submit">Valider mes définitions</button>
    </form>
  </div>
</div>
<script>
  const tempsInitial = <%= time %>;  
</script>
<script src="../pagescripts/defscript.js"></script>