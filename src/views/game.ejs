 <!-- Contenu principal centré -->
 <div id="app" class="d-flex justify-content-center min-vh-100">
    <div class="container-fluid px-4">
      <!-- Section utilisateur -->
        <div class="container mt-3">
            <div class="d-flex justify-content-start align-items-center w-25">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="text-primary svgIcon">
                    <path d="M256 73.825a182.175 182.175 0 1 0 182.18 182.18A182.177 182.177 0 0 0 256 73.825zm0 71.833a55.05 55.05 0 1 1-55.054 55.046A55.046 55.046 0 0 1 256 145.658zm.52 208.723h-80.852c0-54.255 29.522-73.573 48.885-90.906a65.68 65.68 0 0 0 62.885 0c19.363 17.333 48.885 36.651 48.885 90.906z" data-name="Profile"/>
                </svg>        
                <!-- Affichage du nom de l'utilisateur ou "Joueur anonyme" -->
                <p class="ms-3 mb-0">
                    <%= pseudo !== "" ? pseudo : "Joueur anonyme" %>
                </p>
            </div>
            <!-- Affichage du score global d'un joueur connecté -->
            <div class="d-flex justify-content-start align-items-center w-25">
                <p class="ms-3 mb-0 text-muted small d-flex align-items-center">
                    <% if (globalScore >= 0) { %>
                        <svg class="text-primary svgIcon" version="1.0" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 64 64" enable-background="new 0 0 64 64" xml:space="preserve" fill="#000000">
                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> 
                                <path fill="#231F20" d="M60,4H48c0-2.215-1.789-4-4-4H20c-2.211,0-4,1.785-4,4H4C1.789,4,0,5.785,0,8v8c0,8.836,7.164,16,16,16 c0.188,0,0.363-0.051,0.547-0.059C17.984,37.57,22.379,41.973,28,43.43V56h-8c-2.211,0-4,1.785-4,4v4h32v-4c0-2.215-1.789-4-4-4h-8 V43.43c5.621-1.457,10.016-5.859,11.453-11.488C47.637,31.949,47.812,32,48,32c8.836,0,16-7.164,16-16V8C64,5.785,62.211,4,60,4z M8,16v-4h8v12C11.582,24,8,20.414,8,16z M56,16c0,4.414-3.582,8-8,8V12h8V16z"></path>
                            </g>
                        </svg>
                    <% } %>
                    <span id="scoreGlobalDisplay">
                        <%= globalScore >= 0 ? `Score global : ${globalScore} pts` : '' %>
                    </span>
                </p>
            </div>
        </div>

        <!-- Titre -->
        <h1 class="text-center mt-4">Jeu des mots</h1>

        <!-- Container principal pour le jeu -->
        <div id="gameContainer" class="container-fluid mt-3">
            <div class="row">
                <div class="col-md-3">
                    <!-- Résultats du jeu -->
                    <div id="gameResults" class="text-center mt-4 d-none">
                        <h2 id="resultMessage"></h2>
                        <p>Le mot était : <b><%= word %></b></p>
                        <p>Votre score final est : <b><span id="finalScore"></span></b> points</p>
                        <button id="replayBtn" class="btn btn-primary mt-3">Jouer à nouveau?</button>
                    </div>
                </div>        
                <!-- Colonne principale du jeu (jeu de mots) -->
                <div id="gameInterface" class="col-md-6 d-flex flex-column align-items-center text-center p-4 border">
                    <!-- Définition du mot -->
                    <h3>Définition du mot :</h3>
                    <p><%= definition %></p>
                    
                    <h2>Mot à deviner :</h2>
                    <div id="wordDisplay" class="mb-3">
                        <% for (let i = 0; i < word.length; i++) { %>
                            <span class="letter" id="letter-<%= i %>">_</span>
                        <% } %>
                    </div>
                    
                    <h3>Score : <span id="score"><%= score %></span> points</h3>

                    <!-- Timer -->
                    <div id="timer-container">
                        <p id="timer">⏳ Temps restant : <b><%= timeLimit %></b> secondes</p>
                    </div>

                    <!-- Formulaire pour tenter une lettre -->
                    <form id="guessForm" action="javascript:void(0);" class="mt-3">
                        <label for="letter">Saisir une lettre :</label>
                        <input type="text" id="letter" maxlength="1" required class="form-control w-25 mx-auto">
                        <button type="submit" class="btn btn-primary mt-2">Essayer</button>
                    </form>
                </div>

                <!-- Colonne pour les suggestions (à droite du jeu) -->
                <div class="col-md-3">
                    <!-- Icône pour afficher les suggestions (initialement masquée) -->
                    <div id="suggestionIcon" class="mt-3 d-none">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="suggestions text-muted">
                            <g data-name="27.Question">
                                <path d="M12 24a12 12 0 1 1 12-12 12.013 12.013 0 0 1-12 12zm0-22a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2z"/>
                                <path d="M13 16h-2v-4h1a3 3 0 1 0-3-3H7a5 5 0 1 1 6 4.9zM11 18h2v2h-2z"/>
                            </g>
                        </svg>
                        <i class="fas fa-search text-info"></i>
                        <small class="text-muted">Afficher les suggestions? (−20 points)</small>
                    </div>

                    <!-- Liste des suggestions possibles (cachée au début) -->
                    <div id="suggestionBox" class="mt-3 d-none p-4">
                        <h4>Mots possibles :</h4>
                        <ul id="suggestionList" class="list-unstyled"></ul>
                    </div>
                </div>
            </div>    
        </div>
    </div>
</div>
<script>
    const allServerSuggestions = <%- JSON.stringify(suggestions) %>;
    const wordFromServer = "<%= word %>".toLowerCase();
    const scoreFromServer = <%= score %>;
    const globalScoreFromServer = <%= globalScore %>;
    const timeLimitFromServer = <%= timeLimit %>;
    const hintIntervalTimeFromServer = <%= hintIntervalTime %>;
    // console.log("Liste des suggestions :", allServerSuggestions);
    console.log("Mot à deviner (en minuscule) : " + wordFromServer);    
</script>
<script src="/pagescripts/gamescript.js"></script>
