 <!-- Contenu principal centré -->
 <div id="app" class="d-flex justify-content-center min-vh-100">
  <div class="container-fluid px-4">
    <h1><%= title %></h1>
    <!-- Table pour afficher toutes les définitions -->
    <table id="definitionsTable" class="display">
      <thead>
        <tr>
          <th>Langue</th>
          <th>Mot</th>
          <th>Définition</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        <% definitions.forEach(def => { %>
          <tr>
            <td><%= def.lang || "—" %></td>
            <td><%= def.word || "—" %></td>
            <td><%= def.definition %></td>
            <td><%= def.source || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<script>
  const serverStep = <%= step %>;
</script>
<script src="/pagescripts/dumpscript.js"></script>