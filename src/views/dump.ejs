<h1><%= title %></h1>

<!-- Table pour afficher toutes les définitions -->
<table id="definitionsTable" class="display">
  <thead>
    <tr>
      <th>Langue</th>
      <th>Mot</th>
      <th>Définition</th>
      <th>Source</th>
    </tr>
  </thead>
  <tbody>
    <% definitions.forEach(def => { %>
      <tr>
        <td><%= def.lang || "—" %></td>
        <td><%= def.word || "—" %></td>
        <td><%= def.definition %></td>
        <td><%= def.source || "—" %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<!-- CSS de DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/jquery.dataTables.min.css">

<!-- Script jQuery (Nécessaire pour DataTables) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Script de DataTables -->
<script src="https://cdn.datatables.net/2.2.2/js/jquery.dataTables.min.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    let table = new DataTable('#definitionsTable', {
      paging: true,             // Active la pagination
      pageLength: <%= step %>,           // Définit le nombre d'éléments par page
      lengthMenu: [5, 10, 20, 50, 100], // Options pour le nombre d'éléments par page
      searching: true,          // Active la barre de recherche
      info: true,               // Affiche les informations sur le nombre d'entrées
      stateSave: false,
    });
  });
</script>
